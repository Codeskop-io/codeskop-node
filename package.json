{
  "name": "@codeskop/node",
  "version": "0.1.0",
  "description": "Codeskop server SDK for Node.js: errors, incoming requests and outgoing API calls from Express, Fastify and Next.js.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "error-monitoring",
    "apm",
    "express",
    "fastify",
    "nextjs",
    "codeskop"
  ],
  "homepage": "https://www.codeskop.com/docs/server/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codeskop-io/codeskop-node.git"
  },
  "bugs": {
    "url": "https://github.com/Codeskop-io/codeskop-node/issues"
  },
  "author": "Codeskop <plinqdevelopers@gmail.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^5.1.0",
    "fastify": "^5.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
